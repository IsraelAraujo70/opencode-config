{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth"],
  "agent": {
    "build": {
      "description": "Build agent configured for command-level approvals",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "allow",
          "git": "ask",
          "git *": "ask",
          "rf": "ask",
          "rf *": "ask",
          "npx": "ask",
          "npx *": "ask",
          "python": "ask",
          "python *": "ask",
          "uvx": "ask",
          "uvx *": "ask"
        }
      }
    },
    "plan": {
      "description": "Plan mode: read and explore to identify the best solution before development",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "webfetch": "allow"
      }
    },
    "auto-builder": {
      "description": "Auto-builder mode: unrestricted tools and edits",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "doom_loop": "allow",
        "external_directory": "allow"
      }
    }
  },
  "mcp": {
    "mgrep": {
      "type": "local",
      "command": ["mgrep", "mcp"],
      "enabled": true
    }
  }
}
