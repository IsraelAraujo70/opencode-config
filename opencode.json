{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@warp-dot-dev/opencode-warp"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--config",
        "/home/israel/.config/opencode/playwright-mcp.config.json"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "description": "Build agent configured for command-level approvals",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "allow",
          "git": "ask",
          "git *": "ask",
          "rf": "ask",
          "rf *": "ask",
          "npx": "ask",
          "npx *": "ask",
          "python": "ask",
          "python *": "ask",
          "uvx": "ask",
          "uvx *": "ask"
        }
      }
    },
    "plan": {
      "description": "Plan mode: read and explore to identify the best solution before development",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "webfetch": "allow",
        "external_directory": "allow"
      }
    },
    "auto-builder": {
      "description": "Auto-builder mode: unrestricted tools and edits",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "doom_loop": "allow",
        "external_directory": "allow"
      }
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4",
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        }
      }
    }
  }
}
